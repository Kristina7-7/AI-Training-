import pandas as pd
import numpy as np

data = {
    "patient_id": ["P001", "P002", "P003", "P004",
                   "P005", "P006", "P007", "P008"],
    "age": [25, 42, 31, 55, 28, 47, 36, 60],
    "heart_rate": ["78", 110, None, "95",
                   -10, "unknown", 125, "88"]
}

# PHASE 1 — DATA CLEANING
df = pd.DataFrame(data)

df["heart_rate"] = pd.to_numeric(
    df["heart_rate"], errors="coerce"
)

print("Missing heart rates:",
      df["heart_rate"].isna().sum())

clean_df = df.dropna(subset=["heart_rate"])
clean_df = clean_df[clean_df["heart_rate"] > 0]

print("\nCleaned DataFrame:")
print(clean_df)
print("Remaining patients:", clean_df.shape[0])

# PHASE 2 — STATISTICAL ANALYSIS
print("\nStatistical Analysis:")
print("Mean HR:", clean_df["heart_rate"].mean())
print("Median HR:", np.median(clean_df["heart_rate"]))
print("Population SD:", np.std(clean_df["heart_rate"]))
print("Maximum HR:", clean_df["heart_rate"].max())
print("Average Age:", clean_df["age"].mean())

# PHASE 3 — PATIENT FILTERING
mask = clean_df["heart_rate"] > 100
high_hr = clean_df[mask]

print("\nPatients with HR > 100:")
print(high_hr)
print("Selected patients:", high_hr.shape[0])
print("Selected average HR:",
      high_hr["heart_rate"].mean())
print("Patient IDs:")
print(high_hr["patient_id"])
